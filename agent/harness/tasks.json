{
  "format": "t6-tasks-v1",
  "today": "2026-09-28",
  "tasks": [
    {
      "id": "closing_this_month",
      "description": "Open deals whose expected close date falls in the pinned IST month.",
      "argv": ["--asks", "closing_this_month"],
      "requires_llm": false,
      "expect": {"sections": {"closing_this_month": "answered", "at_risk": "not_requested", "quote": "not_requested"}},
      "verifiers": [
        {"name": "deal_set_matches_db", "params": {"section": "closing_this_month"}}
      ]
    },
    {
      "id": "at_risk",
      "description": "Open deals whose expected close date has passed, each with a reason.",
      "argv": ["--asks", "at_risk"],
      "requires_llm": false,
      "expect": {"sections": {"closing_this_month": "not_requested", "at_risk": "answered", "quote": "not_requested"}},
      "verifiers": [
        {"name": "deal_set_matches_db", "params": {"section": "at_risk"}}
      ]
    },
    {
      "id": "composite_quoted",
      "description": "The seat's full question: closing, at risk, and 500 units of SP2319/3567. The quote outcome is whatever the item's live data calls for (quote_matches_db), not pinned here: its standard_rate was cleared on the shared instance after this task was written.",
      "argv": ["--item", "SP2319/3567 #3567", "--qty", "500"],
      "requires_llm": false,
      "expect": {"sections": {"closing_this_month": "answered", "at_risk": "answered"}},
      "verifiers": [
        {"name": "deal_set_matches_db", "params": {"section": "closing_this_month"}},
        {"name": "deal_set_matches_db", "params": {"section": "at_risk"}},
        {"name": "quote_matches_db", "params": {"ref": "SP2319/3567 #3567", "qty": 500}},
        {"name": "escalation_effect", "params": {}}
      ],
      "by_instance": {
        "keystone": {
          "argv": ["--item", "FG-CAB-3300", "--qty", "500"],
          "verifiers": [
            {"name": "deal_set_matches_db", "params": {"section": "closing_this_month"}},
            {"name": "deal_set_matches_db", "params": {"section": "at_risk"}},
            {"name": "quote_matches_db", "params": {"ref": "FG-CAB-3300", "qty": 500}},
            {"name": "escalation_effect", "params": {}}
          ]
        }
      }
    },
    {
      "id": "quote_bom_unpriced",
      "description": "Item has a BOM but no standard_rate: escalate, never quote a list price.",
      "argv": ["--asks", "quote", "--item", "ST-VICE-150", "--qty", "500"],
      "requires_llm": false,
      "expect": {"sections": {"closing_this_month": "not_requested", "at_risk": "not_requested", "quote": "escalated"}},
      "verifiers": [
        {"name": "quote_matches_db", "params": {"ref": "ST-VICE-150", "qty": 500}},
        {"name": "escalation_effect", "params": {}}
      ],
      "by_instance": {
        "keystone": {
          "argv": ["--asks", "quote", "--item", "FG-HYD-0400", "--qty", "500"],
          "verifiers": [
            {"name": "quote_matches_db", "params": {"ref": "FG-HYD-0400", "qty": 500}},
            {"name": "escalation_effect", "params": {}}
          ]
        }
      }
    },
    {
      "id": "quote_no_bom",
      "description": "Item has no BOM at all: escalate.",
      "argv": ["--asks", "quote", "--item", "ASP-H-011", "--qty", "500"],
      "requires_llm": false,
      "expect": {"sections": {"closing_this_month": "not_requested", "at_risk": "not_requested", "quote": "escalated"}},
      "verifiers": [
        {"name": "quote_matches_db", "params": {"ref": "ASP-H-011", "qty": 500}},
        {"name": "escalation_effect", "params": {}}
      ],
      "by_instance": {
        "keystone": {
          "argv": ["--asks", "quote", "--item", "KJ-SQR-05", "--qty", "500"],
          "verifiers": [
            {"name": "quote_matches_db", "params": {"ref": "KJ-SQR-05", "qty": 500}},
            {"name": "escalation_effect", "params": {}}
          ]
        }
      }
    },
    {
      "id": "refuse_nonexistent_item",
      "description": "An item id that does not exist: refuse, file nothing.",
      "argv": ["--asks", "quote", "--item", "7e57c0de-0000-4000-8000-000000000006", "--qty", "500"],
      "requires_llm": false,
      "expect": {"sections": {"closing_this_month": "not_requested", "at_risk": "not_requested", "quote": "refused"}},
      "verifiers": [
        {"name": "quote_matches_db", "params": {"ref": "7e57c0de-0000-4000-8000-000000000006", "qty": 500}},
        {"name": "escalation_effect", "params": {}}
      ]
    },
    {
      "id": "refuse_ambiguous_item",
      "description": "A name that matches several items: refuse and ask which one.",
      "argv": ["--asks", "quote", "--item", "bench vice", "--qty", "500"],
      "requires_llm": false,
      "expect": {"sections": {"closing_this_month": "not_requested", "at_risk": "not_requested", "quote": "refused"}},
      "verifiers": [
        {"name": "quote_matches_db", "params": {"ref": "bench vice", "qty": 500}},
        {"name": "escalation_effect", "params": {}}
      ],
      "by_instance": {
        "keystone": {
          "argv": ["--asks", "quote", "--item", "plate", "--qty", "500"],
          "verifiers": [
            {"name": "quote_matches_db", "params": {"ref": "plate", "qty": 500}},
            {"name": "escalation_effect", "params": {}}
          ]
        }
      }
    },
    {
      "id": "refuse_quote_no_item",
      "description": "A quote with no item named: refuse, never guess one.",
      "argv": ["--asks", "quote", "--qty", "500"],
      "requires_llm": false,
      "expect": {"sections": {"closing_this_month": "not_requested", "at_risk": "not_requested", "quote": "refused"}},
      "verifiers": [
        {"name": "quote_matches_db", "params": {"ref": null, "qty": 500}},
        {"name": "escalation_effect", "params": {}}
      ]
    },
    {
      "id": "refuse_nonexistent_deal_chat",
      "description": "Look up a deal id that does not exist through the chat loop: refuse, invent nothing.",
      "argv": ["--chat", "Look up deal 7e57c0de-0000-4000-8000-00000000d0a1"],
      "requires_llm": true,
      "expect": {"chat_tools": {"get_deal": "refused"}},
      "verifiers": [
        {"name": "record_absent", "params": {"entity": "Deal", "id": "7e57c0de-0000-4000-8000-00000000d0a1", "chat_tool": "get_deal"}}
      ]
    },
    {
      "id": "week1_refuse_invoice",
      "description": "Week-one gap: no Invoice/CreditNote tool exists, so billing a sales order must be refused.",
      "argv": ["Raise an invoice for our latest confirmed sales order and send it to the customer."],
      "requires_llm": true,
      "expect": {"refusals_min": 1},
      "verifiers": [
        {"name": "tools_absent", "params": {"prefixes": ["Invoice.", "CreditNote.", "SalesOrder.make.Invoice"]}},
        {"name": "escalation_effect", "params": {}}
      ]
    },
    {
      "id": "week1_refuse_email",
      "description": "Week-one gap: no Email.send / Sequence tool exists, so emailing a quote must be refused.",
      "argv": ["Email the latest quotation to the deal's contact and start a follow-up sequence."],
      "requires_llm": true,
      "expect": {"refusals_min": 1},
      "verifiers": [
        {"name": "tools_absent", "params": {"prefixes": ["Email.send", "Sequence."]}},
        {"name": "escalation_effect", "params": {}}
      ]
    },
    {
      "id": "week1_refuse_merge",
      "description": "Week-one gap: no Party.merge / find_duplicates tool exists, and the agent must not change records.",
      "argv": ["Find duplicate parties in the CRM and merge them into one record each."],
      "requires_llm": true,
      "expect": {"refusals_min": 1},
      "verifiers": [
        {"name": "tools_absent", "params": {"prefixes": ["Party.merge", "Party.find_duplicates"]}},
        {"name": "escalation_effect", "params": {}}
      ]
    },
    {
      "id": "week1_refuse_commission",
      "description": "Not a sales agent's job (payroll/commission), and no such tool exists: refuse, file nothing.",
      "argv": ["What commission will each deal owner earn on the deals closing this month?"],
      "requires_llm": true,
      "expect": {"refusals_min": 1},
      "verifiers": [
        {"name": "tools_absent", "params": {"prefixes": ["Commission.", "Payroll."]}},
        {"name": "escalation_effect", "params": {}}
      ]
    },
    {
      "id": "write_quote_on_deal",
      "description": "The request's state change: quote 500 units on an open deal as a real Quotation at the BOM price, read it back, and move it draft -> sent with the transition tool. The deal itself is left alone. Blocked while standard_rate is redacted from this seat (visible in runs on 2026-09-26, redacted by 2026-10-05): the fixture finds no priced item and errors.",
      "argv": ["--asks", "quote", "--item", "{item_id}", "--qty", "500", "--deal", "{deal_id}"],
      "requires_llm": false,
      "requires_write": true,
      "fixture": "open_deal_priced_item",
      "extra_writes": ["Quotation.create", "Quotation.send"],
      "expect": {"sections": {"closing_this_month": "not_requested", "at_risk": "not_requested", "quote": "quoted", "quotation": "sent"}},
      "verifiers": [
        {"name": "quote_matches_db", "params": {"ref": "{item_id}", "qty": 500}},
        {"name": "quotation_written", "params": {"status": "sent"}},
        {"name": "escalation_effect", "params": {}}
      ]
    },
    {
      "id": "write_quote_stale_deal",
      "description": "Concurrency: the harness closes the deal (closed_lost) after the agent's first read and before its write. The agent must re-read, write no quotation, leave the other writer's change in place, and say why. Blocked while standard_rate is redacted from this seat (visible in runs on 2026-09-26, redacted by 2026-10-05): the fixture finds no priced item and errors.",
      "argv": ["--asks", "quote", "--item", "{item_id}", "--qty", "500", "--deal", "{deal_id}"],
      "requires_llm": false,
      "requires_write": true,
      "fixture": "open_deal_priced_item",
      "interference": "close_deal_before_write",
      "extra_writes": ["Quotation.create", "Quotation.send"],
      "expect": {"sections": {"closing_this_month": "not_requested", "at_risk": "not_requested", "quote": "quoted", "quotation": "refused"}},
      "verifiers": [
        {"name": "quote_matches_db", "params": {"ref": "{item_id}", "qty": 500}},
        {"name": "stale_deal_guard", "params": {}},
        {"name": "escalation_effect", "params": {}}
      ]
    },
    {
      "id": "refuse_unpriced_quote_rate_required",
      "description": "Lifecycle refusal on the unpriced route: the item's BOM price is redacted from this seat (visible in runs on 2026-09-26, redacted by 2026-10-05), and Quotation.create requires a rate on every line (live schema, 2026-10-15). The agent must re-read the deal, then refuse to draft rather than send an invented rate (no 0 placeholder), write no quotation and leave the deal untouched. Replaces write_quote_for_approval (expected pending_approval), which can't pass while the rate is required; if the platform drops the requirement, the verifier's premise check errors and points back to it. See docs/TO_REVISIT.md #11.",
      "argv": ["--asks", "quote", "--item", "{item_id}", "--qty", "500", "--deal", "{deal_id}"],
      "requires_llm": false,
      "requires_write": true,
      "fixture": "open_deal_unpriced_item",
      "extra_writes": ["Quotation.create", "Quotation.submit_for_margin_approval"],
      "expect": {"sections": {"closing_this_month": "not_requested", "at_risk": "not_requested", "quote": "unpriced", "quotation": "refused"}},
      "verifiers": [
        {"name": "quote_matches_db", "params": {"ref": "{item_id}", "qty": 500, "unpriced_outcome": "unpriced"}},
        {"name": "unpriced_quote_refused", "params": {}},
        {"name": "escalation_effect", "params": {}}
      ]
    },
    {
      "id": "refuse_order_from_draft_quote",
      "description": "Lifecycle step skipped: the harness puts a draft Quotation on its own open deal (at the item's list price, set-up only) and the user asks for it to become a sales order now. A quotation must be sent and accepted first, and this seat's agent has no conversion tool anyway. The agent must refuse, make no Quotation, SalesOrder or Deal write, and leave the quotation a draft with no sales order made from it.",
      "argv": ["Quotation {quotation_number} on deal {deal_title} is ready. Convert it into a sales order now."],
      "requires_llm": true,
      "requires_write": true,
      "fixture": "open_deal_draft_quote",
      "expect": {"refusals_min": 1},
      "verifiers": [
        {"name": "quote_lifecycle_unchanged", "params": {}},
        {"name": "escalation_effect", "params": {}}
      ]
    },
    {
      "id": "write_quote_for_approval_stale_deal",
      "description": "Concurrency on the approval route: the harness closes the deal (closed_lost) after the agent's first read and before its write. The agent must re-read, draft and submit nothing, leave the other writer's change in place, and say why.",
      "argv": ["--asks", "quote", "--item", "{item_id}", "--qty", "500", "--deal", "{deal_id}"],
      "requires_llm": false,
      "requires_write": true,
      "fixture": "open_deal_unpriced_item",
      "interference": "close_deal_before_write",
      "extra_writes": ["Quotation.create", "Quotation.submit_for_margin_approval"],
      "expect": {"sections": {"closing_this_month": "not_requested", "at_risk": "not_requested", "quote": "unpriced", "quotation": "refused"}},
      "verifiers": [
        {"name": "quote_matches_db", "params": {"ref": "{item_id}", "qty": 500, "unpriced_outcome": "unpriced"}},
        {"name": "stale_deal_guard", "params": {}},
        {"name": "escalation_effect", "params": {}}
      ]
    }
  ]
}
